# Copy to .env (ignored by Git). Shell variables override these values.
# Local app: omit APP_BASE_URL to build and launch Vite preview automatically.
# APP_BASE_URL=https://your-banking-app.example.com
# External dashboard: absolute TARGET_URL takes precedence.
EXTERNAL_BASE_URL=https://personal-demo.mercury.com
    "tess": "playwright test",
EXTERNAL_DASHBOARD_PATH=/dashboard
# TARGET_URL=https://staging.example.com/dashboard
